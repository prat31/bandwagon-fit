{
  "name": "Sleep pact: bedtime with tolerance and minimum duration, both must pass",
  "spec": {
    "schemaVersion": 1, "kind": "TARGET", "metric": { "id": "sleep_minutes" },
    "daily": { "op": "all", "conditions": [
      { "metric": "bedtime", "cmp": "<=", "value": -60, "toleranceMin": 30 },
      { "metric": "sleep_minutes", "cmp": ">=", "value": 420 }
    ] },
    "aggregate": "DAYS_HIT", "goal": { "target": 3 }, "groupStreak": true,
    "window": { "start": "2026-11-02", "end": "2026-11-04" },
    "display": { "templateId": "sleep_pact", "renderer": "BOARD", "title": "Pact" }
  },
  "members": {
    "a": [
      { "date": "2026-11-02", "sleep": { "start": "2026-11-01T17:50:00Z", "end": "2026-11-02T01:20:00Z", "durationMinutes": 450, "zoneId": "Asia/Kolkata" }, "shared": ["sleep_minutes"] },
      { "date": "2026-11-03", "sleep": { "start": "2026-11-02T18:00:00Z", "end": "2026-11-03T01:30:00Z", "durationMinutes": 450, "zoneId": "Asia/Kolkata" }, "shared": ["sleep_minutes"] },
      { "date": "2026-11-04", "sleep": { "start": "2026-11-03T18:01:00Z", "end": "2026-11-04T02:00:00Z", "durationMinutes": 470, "zoneId": "Asia/Kolkata" }, "shared": ["sleep_minutes"] }
    ],
    "b": [
      { "date": "2026-11-02", "sleep": { "start": "2026-11-01T16:30:00Z", "end": "2026-11-01T23:00:00Z", "durationMinutes": 390, "zoneId": "Asia/Kolkata" }, "shared": ["sleep_minutes"] },
      { "date": "2026-11-03", "steps": 5000, "shared": ["steps"] }
    ]
  },
  "expected": {
    "a": { "score": 2, "daysHit": 2, "finished": false, "notShared": false },
    "b": { "score": 0, "daysHit": 0, "finished": false, "notShared": false }
  },
  "days": {
    "a": { "2026-11-02": "HIT", "2026-11-03": "HIT", "2026-11-04": "MISSED" },
    "b": { "2026-11-02": "MISSED", "2026-11-03": "NOT_SHARED", "2026-11-04": null }
  }
}
