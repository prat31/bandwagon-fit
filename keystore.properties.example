# Copy to keystore.properties (git-ignored) to sign release builds with your Play upload key.
# CI can set BANDWAGON_STOREFILE, BANDWAGON_STOREPASSWORD, BANDWAGON_KEYALIAS and BANDWAGON_KEYPASSWORD instead.
# storeFile is relative to the repo root, or an absolute path (no ~).
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
